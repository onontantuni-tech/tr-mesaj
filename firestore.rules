rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function nd() { return request.resource.data; }
    function pair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function areFriends(a, b) {
      let f = /databases/$(database)/documents/friends/$(pair(a, b));
      return exists(f) && get(f).data.status == 'accepted';
    }
    // Askıya alınmış / yasaklı hesap yazamaz
    function notBanned() {
      let b = /databases/$(database)/documents/bans/$(request.auth.uid);
      return !exists(b) || get(b).data.until < request.time.toMillis();
    }
    function blockedBy(a, b) { return exists(/databases/$(database)/documents/blocks/$(a + '_' + b)); }

    // Herkese açık profil: ad, soyad, TR ID, şifreleme açık anahtarı
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid)
        && nd().keys().hasOnly(['first','last','nick','code','pub','joined','av','bio'])
        && nd().nick is string && nd().nick.size() <= 62
        && (!('bio' in nd()) || (nd().bio is string && nd().bio.size() <= 140))
        && (!('av' in nd()) || nd().av is number);
    }

    // profil fotoğrafı (küçük JPEG, herkese açık)
    match /avatars/{uid} {
      allow read: if signedIn();
      allow delete: if isMe(uid);
      allow create, update: if isMe(uid) && notBanned()
        && nd().keys().hasOnly(['img','at'])
        && nd().img is string && nd().img.size() <= 60000
        && nd().img.matches('^data:image/(jpeg|webp);base64,[A-Za-z0-9+/=]+$')
        && nd().at is number;
    }

    // TR ID'lerin benzersizliği
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && nd().uid == request.auth.uid && code.matches('^[0-9]{6}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Gizli alan: telefon, özel anahtar, kişiler. Sadece sahibi okuyup yazabilir.
    match /private/{uid}/{document=**} {
      allow read, write: if isMe(uid);
    }

    // Gruplar: sadece üyeler görür; yöneticiler düzenler; herkes kendini çıkarabilir
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && notBanned()
        && nd().createdBy == request.auth.uid
        && nd().admins == [request.auth.uid]
        && request.auth.uid in nd().members
        && nd().members.size() <= 50
        && nd().name is string && nd().name.size() > 0 && nd().name.size() <= 50;
      allow update: if signedIn()
        && nd().createdBy == resource.data.createdBy
        && nd().members.size() <= 50
        && nd().name is string && nd().name.size() > 0 && nd().name.size() <= 50
        && nd().admins.hasOnly(nd().members)
        && (
          request.auth.uid in resource.data.admins
          ||
          (request.auth.uid in resource.data.members
            && !(request.auth.uid in nd().members)
            && resource.data.members.removeAll([request.auth.uid]).hasAll(nd().members)
            && nd().members.hasAll(resource.data.members.removeAll([request.auth.uid]))
            && nd().name == resource.data.name)
        );
    }

    // Mesajlar: sadece mesajın üyeleri okuyabilir. İçerik şifreli.
    match /msgs/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && notBanned()
        && nd().from == request.auth.uid
        && request.auth.uid in nd().members
        && nd().ct is string && nd().ct.size() < 20000
        && nd().iv is string && nd().iv.size() < 40
        && (!('men' in nd()) || (nd().men is list && nd().men.size() <= 50))
        && (
          (nd().to is string
            && nd().to != request.auth.uid
            && nd().members == [request.auth.uid, nd().to]
            && !('gid' in nd())
            && areFriends(request.auth.uid, nd().to))
          ||
          (nd().gid is string
            && !('to' in nd())
            && get(/databases/$(database)/documents/groups/$(nd().gid)).data.members == nd().members)
        );
      // düzenleme (gönderen, 15 dakika içinde, sadece şifreli içerik) ya da tepki (herkes sadece kendi tepkisini)
      allow update: if signedIn() && request.auth.uid in resource.data.members && (
        (resource.data.from == request.auth.uid
          && request.time.toMillis() < resource.data.at + 900000
          && nd().diff(resource.data).affectedKeys().hasOnly(['ct', 'iv', 'ed'])
          && nd().ct is string && nd().ct.size() < 20000
          && nd().iv is string && nd().iv.size() < 40
          && nd().ed is number)
        ||
        (nd().diff(resource.data).affectedKeys().hasOnly(['rx'])
          && nd().rx is map && nd().rx.size() <= 60
          && nd().rx.diff(resource.data.get('rx', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in nd().rx) || nd().rx[request.auth.uid] in ['❤️', '😂', '👍', '😮', '😢', '🙏']))
      );
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Çevrimiçi / yazıyor / son görülme. vis: herkes, arkadaşlar ya da kimse
    match /presence/{u} {
      allow read: if signedIn() && (request.auth.uid == u || resource.data.vis == 'all'
        || (resource.data.vis == 'friends' && areFriends(request.auth.uid, u)));
      allow write: if isMe(u)
        && nd().keys().hasOnly(['at', 'vis', 'ty', 'tyAt'])
        && nd().vis in ['all', 'friends', 'none']
        && nd().at is number;
    }

    // Arkadaşlık: belge adı "küçükUid_büyükUid". İstek gönderilir, karşı taraf kabul ederse yazışılır.
    match /friends/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && nd().keys().hasOnly(['members', 'from', 'to', 'status', 'at'])
        && nd().from == request.auth.uid
        && nd().to is string && nd().to != request.auth.uid
        && nd().status == 'pending'
        && nd().at is number
        && id == pair(request.auth.uid, nd().to)
        && nd().members == (request.auth.uid < nd().to ? [request.auth.uid, nd().to] : [nd().to, request.auth.uid])
        && exists(/databases/$(database)/documents/users/$(nd().to))
        && !blockedBy(nd().to, request.auth.uid)
        && notBanned();
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && nd().keys().hasOnly(['members', 'from', 'to', 'status', 'at'])
        && nd().members == resource.data.members
        && nd().at is number
        && (
          // karşı taraf kabul eder ya da reddeder
          (resource.data.status == 'pending'
            && resource.data.to == request.auth.uid
            && nd().from == resource.data.from && nd().to == resource.data.to
            && nd().status in ['accepted', 'declined'])
          ||
          // reddedilen istek tekrar gönderilir (reddedilen kişi 24 saat bekler)
          (resource.data.status == 'declined'
            && nd().status == 'pending'
            && !blockedBy(nd().to, request.auth.uid)
            && nd().from == request.auth.uid
            && nd().to in resource.data.members && nd().to != request.auth.uid
            && (resource.data.from != request.auth.uid || request.time.toMillis() > resource.data.at + 86400000))
        );
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Engelleme: belge adı "engelleyen_engellenen". Engellenen kişi arkadaşlık isteği gönderemez.
    match /blocks/{id} {
      allow read, delete: if signedIn() && resource.data.by == request.auth.uid;
      allow create: if signedIn()
        && nd().keys().hasOnly(['by', 'target', 'at'])
        && nd().by == request.auth.uid
        && nd().target is string && nd().target != request.auth.uid
        && id == request.auth.uid + '_' + nd().target;
    }

    // Şikâyetler: herkes yazabilir, sadece yöneticiler (sunucu üzerinden) okur
    match /reports/{id} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && nd().keys().hasOnly(['by', 'target', 'reason', 'note', 'msgs', 'ctx', 'at', 'status'])
        && nd().by == request.auth.uid
        && nd().target is string && nd().target != request.auth.uid
        && nd().reason in ['taciz', 'spam', 'uygunsuz', 'hile', 'diger']
        && nd().status == 'open'
        && nd().note is string && nd().note.size() <= 500
        && nd().msgs is list && nd().msgs.size() <= 20
        && nd().ctx is string && nd().ctx.size() <= 80
        && nd().at is number;
    }

    // Askıya alma / yasak: sadece sunucu yazar, kişi kendi durumunu görür
    match /bans/{u} {
      allow read: if isMe(u);
      allow write: if false;
    }
    match /deletions/{x} { allow read, write: if false; }

    // VIP rozeti: herkes görür, sadece sunucu yazar
    match /badges/{u} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Profil görüntüleme: bakan kişi kendi kaydını yazar; listeyi sadece sunucu okur (VIP'e gösterir)
    match /profile_views/{viewed}/v/{viewer} {
      allow read: if false;
      allow create, update: if isMe(viewer) && viewed != viewer
        && nd().keys().hasOnly(['at']) && nd().at is number;
    }

    // Şifreli fotoğraf ve ses parçaları
    match /blobs/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && nd().from == request.auth.uid
        && request.auth.uid in nd().members
        && nd().members.size() <= 50
        && nd().d is string && nd().d.size() < 850000;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Okundu bilgisi: belge adı "okuyan_sohbet". Sadece ilgili kişiler görür, sadece okuyan yazar.
    match /reads/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if signedIn()
        && nd().members[0] == request.auth.uid
        && nd().members.size() == 2
        && id == request.auth.uid + '_' + nd().members[1]
        && nd().at is number;
    }

    // Telefon eşleştirme: istemciler okuyamaz, sadece sunucu fonksiyonu okur
    match /phones/{p} {
      allow read: if false;
      allow create: if signedIn() && nd().uid == request.auth.uid && nd().keys().hasOnly(['uid']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Aramalar: sinyal bilgisi sadece iki tarafa açık. Medya cihazlar arasında doğrudan ve şifreli akar.
    match /calls/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && nd().from == request.auth.uid
        && nd().to is string && nd().to != request.auth.uid
        && nd().members == [request.auth.uid, nd().to]
        && nd().state == 'ringing'
        && areFriends(request.auth.uid, nd().to)
        && notBanned();
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && nd().from == resource.data.from
        && nd().to == resource.data.to
        && nd().members == resource.data.members
        && nd().offer == resource.data.offer;
      match /cands/{x} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/calls/$(cid)).data.members;
        allow create: if signedIn() && nd().by == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/calls/$(cid)).data.members;
      }
    }

    // Oyunlar: masayı sohbet üyeleri görür, herkes sadece kendi taşlarını görür. Bütün yazmalar sunucudan.
    match /games/{gid} {
      allow read: if signedIn() && (request.auth.uid in resource.data.members || resource.data.public == true);
      allow write: if false;
      match /hands/{u} {
        allow read: if isMe(u);
        allow write: if false;
      }
      // masa sohbeti: masadakiler yazar, masayı görebilen herkes okur
      match /chat/{x} {
        allow read: if signedIn() && (request.auth.uid in get(/databases/$(database)/documents/games/$(gid)).data.members
          || get(/databases/$(database)/documents/games/$(gid)).data.public == true);
        allow create: if signedIn() && notBanned()
          && nd().keys().hasOnly(['by', 'text', 'at'])
          && nd().by == request.auth.uid
          && nd().text is string && nd().text.size() > 0 && nd().text.size() <= 120
          && nd().at is number
          && request.auth.uid in get(/databases/$(database)/documents/games/$(gid)).data.members;
      }
    }
    match /gsecret/{gid} {
      allow read, write: if false;
    }

    // Jeton: herkes sadece kendi cüzdanını görür; bakiye sadece sunucuda değişir
    match /wallets/{u} {
      allow read: if isMe(u);
      allow write: if false;
    }
    match /ledger/{x} { allow read, write: if false; }
    match /rewards/{x} { allow read, write: if false; }
    match /house/{x} { allow read, write: if false; }
    match /house_ledger/{x} { allow read, write: if false; }
    // Sıralama: giriş yapan herkes görür, sadece sunucu yazar
    // Oyun geçmişi: sadece sahibi okur, sunucu yazar
    match /gh/{u}/g/{x} {
      allow read: if isMe(u);
      allow write: if false;
    }
    match /lb_day/{d}/u/{u} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /lb_week/{w}/{t}/{u} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /lb_month/{m}/u/{u} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Durumlar
    match /statuses/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) && notBanned()
        && nd().text is string && nd().text.size() <= 300;
    }
  }
}
